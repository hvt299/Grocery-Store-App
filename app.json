{
  "expo": {
    "name": "Grocery Store App",
    "slug": "grocery-store-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-app.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-app.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.huathai.GroceryStoreApp",
      "softwareKeyboardLayoutMode": "pan",
      "userInterfaceStyle": "automatic"
    },
    "web": {
      "favicon": "./assets/logo-app.png"
    },
    "extra": {
      "eas": {
        "projectId": "93754d5f-7799-4038-a991-ab83173c8a05"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "style": "dark-content",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-app.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}